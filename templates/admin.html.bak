<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin – RL 1v1</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>body{padding:2rem}</style>
</head>
<body class="container">
  <h1 class="mb-3">Admin – RL 1v1</h1>
  <div class="mb-3">
    <form method="post" class="d-inline">
      <input type="hidden" name="code" value="{{code}}">
      <input type="hidden" name="action" value="toggle_signups">
      <button class="btn btn-sm {{'btn-success' if not signups_open else 'btn-warning'}}">
        {{ 'Open signups' if not signups_open else 'Close signups' }}
      </button>
    </form>
    <form method="post" class="d-inline ms-2">
      <input type="hidden" name="code" value="{{code}}">
      <input type="hidden" name="action" value="shuffle_fill">
      <button class="btn btn-sm btn-secondary">Shuffle Fill by Timestamp</button>
    </form>
    <a class="btn btn-sm btn-outline-primary ms-2" href="{{ url_for('export_csv') }}?code={{code}}">Export CSV</a>
    <a class="btn btn-sm btn-outline-dark ms-2" href="{{ url_for('roster_json') }}">View JSON</a>
  </div>

  <div class="row">
    <div class="col-md-4">
      <h3>Players ({{ players|length }}/{{cap_players}})</h3>
      <ul class="list-group">
      {% for r in players %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong>{{ r.display_name }}</strong> <small class="text-muted">({{ r.discord }})</small>
            {% if r.rank %}<span class="badge bg-info-subtle text-dark ms-1">{{ r.rank }}</span>{% endif %}
            {% if r.region %}<span class="badge bg-light text-dark ms-1">{{ r.region }}</span>{% endif %}
          </div>
          <div>
            <form method="post" class="d-inline">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="status">
              <select name="new_status" onchange="this.form.submit()" class="form-select form-select-sm">
                <option value="player" selected>player</option>
                <option value="sub">sub</option>
                <option value="waitlist">waitlist</option>
              </select>
            </form>
            <form method="post" class="d-inline ms-1">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="delete">
              <button class="btn btn-sm btn-outline-danger">✕</button>
            </form>
          </div>
        </li>
      {% endfor %}
      </ul>
    </div>

    <div class="col-md-4">
      <h3>Subs ({{ subs|length }}/{{cap_subs}})</h3>
      <ul class="list-group">
      {% for r in subs %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong>{{ r.display_name }}</strong> <small class="text-muted">({{ r.discord }})</small>
            {% if r.rank %}<span class="badge bg-info-subtle text-dark ms-1">{{ r.rank }}</span>{% endif %}
            {% if r.region %}<span class="badge bg-light text-dark ms-1">{{ r.region }}</span>{% endif %}
          </div>
          <div>
            <form method="post" class="d-inline">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="status">
              <select name="new_status" onchange="this.form.submit()" class="form-select form-select-sm">
                <option value="player">player</option>
                <option value="sub" selected>sub</option>
                <option value="waitlist">waitlist</option>
              </select>
            </form>
            <form method="post" class="d-inline ms-1">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="delete">
              <button class="btn btn-sm btn-outline-danger">✕</button>
            </form>
          </div>
        </li>
      {% endfor %}
      </ul>
    </div>

    <div class="col-md-4">
      <h3>Waitlist ({{ waitlist|length }})</h3>
      <ul class="list-group">
      {% for r in waitlist %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong>{{ r.display_name }}</strong> <small class="text-muted">({{ r.discord }})</small>
            {% if r.rank %}<span class="badge bg-info-subtle text-dark ms-1">{{ r.rank }}</span>{% endif %}
            {% if r.region %}<span class="badge bg-light text-dark ms-1">{{ r.region }}</span>{% endif %}
          </div>
          <div>
            <form method="post" class="d-inline">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="status">
              <select name="new_status" onchange="this.form.submit()" class="form-select form-select-sm">
                <option value="player">player</option>
                <option value="sub">sub</option>
                <option value="waitlist" selected>waitlist</option>
              </select>
            </form>
            <form method="post" class="d-inline ms-1">
              <input type="hidden" name="code" value="{{code}}">
              <input type="hidden" name="id" value="{{r.id}}">
              <input type="hidden" name="action" value="delete">
              <button class="btn btn-sm btn-outline-danger">✕</button>
            </form>
          </div>
        </li>
      {% endfor %}
      </ul>
    </div>
  </div>
</body>
</html>
