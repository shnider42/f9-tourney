<!doctype html>
<html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Thanks!</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<style>body{padding:2rem}</style>
</head>
<body class="container">
  <h1>You're in! 🎉</h1>
  {% if status == "player" %}
    <p>You grabbed a <strong>Player</strong> slot.</p>
  {% elif status == "sub" %}
    <p>You grabbed a <strong>Sub</strong> slot.</p>
  {% else %}
    <p>You're on the <strong>Waitlist</strong>. We'll ping you if a spot opens.</p>
  {% endif %}
  <a class="btn btn-primary" href="{{ url_for('index') }}">Back to roster</a>
</body></html>
